---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/includes/navbar.astro";
import Home from "@/includes/home.astro";
import About from "@/includes/about.astro";
import Projects from "@/includes/projects.astro";
import Contact from "@/includes/contact.astro";
import Footer from "@/includes/footer.astro";
import main_data from "../../../main.json";

const description = main_data.site.description;
const title = main_data.site.title;
---

<Layout title={title} description={description}>
	<Nav />
	<Home />
	<About />
	<Projects />
	<Contact />
	<Footer />
</Layout>
