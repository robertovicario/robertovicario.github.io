---
import links from "../../../href.json";

const technologies = [
	"java", "py", "c", "r", "js", "ts",
	"spring", "fastapi", "react", "mysql", "redis", "mongodb",
	"git", "docker", "kubernetes", "nginx", "gcp", "bigquery",
	"pandas", "sklearn", "tensorflow", "opencv", "mlflow", "airflow"
];
---

<div class="relative overflow-x-hidden py-16">
	<div
		class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"
	>
	</div>
	<div
		class="flex animate-scroll hover:animate-paused gap-12 md:gap-20 w-max"
	>
		{
			[...technologies, ...technologies, ...technologies].map((tech) => (
				<div class="flex items-center gap-2 group transition-all duration-300">
					<img
						class="h-7 w-auto object-contain transition-transform group-hover:scale-110 opacity-60 me-2"
						src={`${links.services.skillIconsApi}?i=${tech}&theme=light`}
						alt={tech}
						width="32"
						height="32"
					/>
					<span class="text-lg font-medium text-[var(--white-icon)]">
						{(() => {
							switch (tech) {
								case "py":
									return "Python";
								case "js":
									return "JavaScript";
								case "ts":
									return "TypeScript";
								case "fastapi":
									return "FastAPI";
								case "mysql":
									return "MySQL";
								case "mongodb":
									return "MongoDB";
								case "gcp":
									return "Google Cloud Platform";
								case "bigquery":
									return "Google BigQuery";
								case "sklearn":
									return "scikit-learn";
								case "tensorflow":
									return "TensorFlow";
								case "opencv":
									return "OpenCV";
								case "mlflow":
									return "MLflow";
								default:
									return (
										tech.charAt(0).toUpperCase() +
										tech.slice(1)
									);
							}
						})()}
					</span>
				</div>
			))
		}
	</div>
</div>

<style is:global>
	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	.animate-scroll {
		animation: scroll 60s linear infinite;
	}

	@media (min-width: 768px) {
		.animate-scroll {
			animation-duration: 50s;
		}
	}
</style>
