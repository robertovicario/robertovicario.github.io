---
import { Image } from "astro:assets";
import _2UML from "../../public/projects/2UML.png";
import cooming_soon from "../../public/projects/coming_soon.png";
import main_data from "../../../main.json";

interface Project {
	title: string;
	image: ImageMetadata;
	link: string;
	preview: string;
	status: string;
}

const info = main_data.main;
const projectImages: Record<string, ImageMetadata> = {
	LarioNow: cooming_soon as ImageMetadata,
	"2UML": _2UML as ImageMetadata,
};

const projects: Project[] = info.projects.content.map((project) => ({
	title: project.name,
	image: projectImages[project.name] ?? (cooming_soon as ImageMetadata),
	link: project.code,
	preview: project.preview,
	status: project.preview === "#" ? "Coming Soon" : "Released",
}));
---

<section
	id="projects"
	class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
	<div class="max-w-5xl mx-auto text-center">
		<h2 class="text-lg text-[var(--primary)] mb-2 shiny-sec">
			Enjoy my work
		</h2>
		<h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
			{info.projects.label}
		</h3>
		<p class="mb-12 text-[var(--white-icon)]">
			Explore a collection of projects showcasing my skills and
			contributions.
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{
				projects.map((project) => (
					<div class="group">
						<a
							href={project.preview}
							target="_blank"
							rel="noopener noreferrer"
							class="block"
						>
							<div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
								<Image
									src={project.image}
									alt={project.title}
									class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
								/>
							</div>

							<div class="flex flex-col md:flex-row items-start md:items-center px-3 gap-2">
								<div class="flex-grow">
									<h4 class="text-2xl font-semibold text-left mb-1 line-clamp-2">
										{project.title}
									</h4>
									<span class="text-sm text-[var(--white-icon)] text-left block">
										{project.status}
									</span>
								</div>

								<div class="hidden md:flex gap-2 mt-2 md:mt-0 md:ml-auto">
									<a
										target="_blank"
										href={project.link}
										aria-label="GitHub"
										class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
									>
										<i
											class="bi bi-code-slash text-3xl"
											aria-hidden="true"
										/>
									</a>

									<a
										target="_blank"
										href={project.preview}
										aria-label="Preview"
										class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
									>
										<i
											class="bi bi-globe2 text-3xl"
											aria-hidden="true"
										/>
									</a>
								</div>
							</div>
						</a>
					</div>
				))
			}
		</div>

		<a
			target="_blank"
			href={info.projects.cta.url}
			aria-label={info.projects.cta.label}
			class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
		>
			<span class="md:text-lg text-md me-2"
				>{info.projects.cta.label}</span
			>
			<i
				class={`bi ${info.projects.cta.icon} text-2xl`}
				aria-hidden="true"></i>
		</a>
	</div>
</section>
