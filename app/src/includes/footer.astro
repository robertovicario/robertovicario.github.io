---
import main_data from "../../../main.json";

const footerSections = main_data.main.footer.map((section) => ({
	label: section.label,
	items: Object.entries(section.content).map(([label, href]) => ({
		label,
		href,
	})),
}));
const copyrightName = footerSections
	.flatMap((section) => section.items)
	.find((item) => !item.href)?.label ?? "";
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
	<div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
		{
			footerSections.map((section) => (
				<div>
					<h3 class="text-lg font-semibold text-[var(--white-icon)] mb-4 text-center md:text-left">
						{section.label}
					</h3>
					<ul class="space-y-2 text-center md:text-left mb-5 md:mb-0">
						{section.items.map((item) => (
							<li class="text-sm text-[var(--white-icon)]">
								{item.href ? (
									<a
										href={item.href}
										target={item.href.startsWith("#") ? undefined : "_blank"}
										class="text-sm text-[var(--white-icon)] hover:underline"
									>
										{item.label}
									</a>
								) : (
									item.label
								)}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<div class="mt-12 pt-8 border-t border-[#ffffff10]">
		<p class="text-center text-sm text-[var(--white-icon)] space-y-2">
			<span class="block sm:inline"
				>Copyright &copy; {new Date().getFullYear()}
				<strong class="font-medium text-[var(--primary)]"
					>{copyrightName}</strong
				>. All rights reserved.</span
			>
		</p>
	</div>
</footer>
